# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Expo
.expo/
.expo-shared/
apps/*/dist/
apps/*/web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Native projects (managed workflow: generated by prebuild)
apps/*/ios/
apps/*/android/

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Prisma — the client is generated on install, never committed
server/src/generated/
server/prisma/*.db
server/prisma/*.db-journal

# Testing
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Caches
.cache/
.turbo/
.eslintcache
