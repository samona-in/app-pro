# ---------------------------------------------------------------------------
# SAMONA — example environment file
#
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
#   cp .env.example .env
#
# Mobile apps read only EXPO_PUBLIC_* variables from apps/pro/.env; anything in
# an Expo bundle is public, so never put a secret behind an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Supabase (auth only) ---------------------------------------------------
#
# Supabase is the identity provider and nothing else. It verifies phone OTP
# credentials and publishes a JWKS; it does NOT host the database or any files.
#
# Project URL, e.g. https://abcdefgh.supabase.co (Dashboard -> API Keys).
# The server uses it to derive the JWKS that verifies access tokens.
SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Optional. Derived from SUPABASE_URL when empty; set only if the project
# publishes its keys somewhere non-standard.
SUPABASE_JWKS_URL=""

# Legacy HS256 signing secret. Leave empty on projects that sign with
# asymmetric keys (ES256) and publish a JWKS — check
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json: if it lists keys, leave this
# empty. Only older projects need it.
SUPABASE_JWT_SECRET=""

# Role assigned to a user provisioned on first sign-in. This API currently
# serves the Pro app only; revisit when the customer app lands.
SIGNUP_DEFAULT_ROLE="PRO"

# --- PostgreSQL -------------------------------------------------------------
#
# PostgreSQL runs on AWS RDS, not on Supabase. Prisma remains the data access
# layer. Dashboard -> RDS -> the instance's endpoint and credentials.
#
# Set both to the same endpoint: this server has no transaction pooler in front
# of it, so a pooled URL would be identical to the direct one. (A connection
# pooler is the right answer if you later put PgBouncer or Supavisor in front
# — DATABASE_URL takes the pooler and DIRECT_URL bypasses it for migrations.)
DATABASE_URL="postgresql://samona:replace-me@db.REGION.rds.amazonaws.com:5432/samona?schema=public"

# Used only by `prisma migrate`. Optional: falls back to DATABASE_URL when
# empty. Only needs to differ when DATABASE_URL points at a pooler.
DIRECT_URL=""

# --- Object storage (AWS S3) -----------------------------------------------
#
# Supabase Storage is not used. Uploads are presigned PUTs straight to these
# buckets, so no bytes pass through this API's JSON bodies.
#
# No credentials are configured here: the SDK resolves them from the ambient
# provider chain (on Fargate, the task role), so there is no key material in
# the environment.
S3_REGION="us-east-1"
S3_BUCKET_SELFIES="pro-selfies"
S3_BUCKET_JOB_IMAGES="job-images"
S3_BUCKET_AVATARS="avatars"

# Optional. Origin public object URLs are built from. Leave empty to use each
# bucket's own regional S3 URL; set it only if objects are served through a CDN
# or custom domain.
S3_PUBLIC_BASE_URL=""

# --- Backend ---------------------------------------------------------------

# Redis connection string (rate limiting, presence, queues).
REDIS_URL="redis://localhost:6379"

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS="http://localhost:8081"

# Node environment: development | test | production
NODE_ENV="development"

# Server-side Google Maps key (geocoding, distance matrix). Keep off the client.
GOOGLE_MAPS_API_KEY="replace-me"

# OSM-compatible geocoder behind the /locations proxy. Photon is the keyless
# default (https://photon.komoot.io); self-host it in production instead of
# depending on the shared public instance.
GEOCODING_BASE_URL="https://photon.komoot.io"
# Per-request geocoder timeout in ms.
GEOCODING_TIMEOUT_MS=8000
# Nominatim-compatible fallback used when the primary geocoder is unreachable.
# Defaults to the shared Nominatim instance. Set it equal to GEOCODING_BASE_URL
# to disable failover.
GEOCODING_FALLBACK_URL="https://nominatim.openstreetmap.org"

# --- Push notifications ----------------------------------------------------
#
# Expo push service. Leave EXPO_ACCESS_TOKEN empty in local dev to record
# notification rows without reaching Expo's servers. Get a token at
# https://expo.dev/settings/access-tokens for real deliveries.
EXPO_ACCESS_TOKEN=""

# Direct Firebase Cloud Messaging (HTTP v1) delivery for Android job alerts.
# Optional: set all three from a Firebase service-account JSON to send FCM
# messages with a per-job TTL, collapse key and notification tag. When they are
# empty the server falls back to Expo push. Never commit a real service-account
# key; the private key may use escaped newlines (\n).
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# How long an FCM job-alert message stays deliverable (ms). Shorter than the
# job-expiry TTL so a stale offer cannot arrive hours later.
JOB_ALERT_TTL_MS="60000"

# Signs the single-use job-offer tokens that let the native Android overlay
# Accept/Reject a job without waiting for the app to open. Generate with
# `openssl rand -hex 32`. When empty the overlay falls back to opening the app.
# Never commit a real value.
JOB_OFFER_SECRET=""
# How long a minted offer token stays redeemable (ms).
JOB_OFFER_TTL_MS="90000"

# Repeating job-alert cadence (ms) and a hard ceiling on how many times one
# alert re-pages a pro who has not acted. Sensible defaults apply when unset.
JOB_ALERT_REPEAT_MS="60000"
JOB_ALERT_MAX_REPEATS="0"

# Minimum gap between two alerts to the same pro for the same job (ms). Applied
# when a job returns to the open pool after a pro releases it.
JOB_ALERT_REARM_COOLDOWN_MS="300000"

# Catch-up: how far back a still-open request is still offered to a pro who
# comes online after it was raised (ms), and how many (nearest-first) are paged
# at once.
JOB_CATCHUP_WINDOW_MS="7200000"
JOB_CATCHUP_LIMIT="3"

# Auto-expiry: how long an unaccepted (REQUESTED) job stays open before it is
# flipped to EXPIRED (ms), and how often the sweep that expires stale jobs runs.
JOB_EXPIRE_TTL_MS="1800000"
JOB_EXPIRE_SWEEP_MS="60000"
