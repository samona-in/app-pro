# ---------------------------------------------------------------------------
# SAMONA — example environment file
#
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
#   cp .env.example .env
#
# Mobile apps read only EXPO_PUBLIC_* variables from apps/pro/.env; anything in
# an Expo bundle is public, so never put a secret behind an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ---------------------------------------------------
#
# Supabase is used purely as the managed PostgreSQL host; Prisma remains the
# data access layer. Both URLs come from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#
# DATABASE_URL must be the POOLED (Supavisor, port 6543) connection used at
# runtime. `pgbouncer=true` tells Prisma not to use prepared statements, which
# a transaction pooler cannot support.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL must be the DIRECT (port 5432) connection. `prisma migrate` needs a
# real session and cannot run through the transaction pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Authentication (Clerk) ------------------------------------------------
#
# Clerk owns phone verification and credentials. Enable "Phone number" as an
# identifier and "Phone code" as a verification strategy in the Clerk dashboard.
#
# Server key. Never ship this to a client.
CLERK_SECRET_KEY="sk_test_replace_me"

# Publishable key. Needed on the SERVER too (not just the app): the backend
# derives the instance's Frontend API from it to verify session tokens.
# Same value as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY in apps/pro/.env.
CLERK_PUBLISHABLE_KEY="pk_test_replace_me"

# Signing secret for the Clerk webhook (Dashboard -> Webhooks -> your endpoint).
# Without it the webhook endpoint refuses events rather than trusting them.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_replace_me"

# Role assigned to a user provisioned on first sign-in. This API currently
# serves the Pro app only; revisit when the customer app lands.
SIGNUP_DEFAULT_ROLE="PRO"

# --- Backend ---------------------------------------------------------------

# Redis connection string (rate limiting, presence, queues).
REDIS_URL="redis://localhost:6379"

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS="http://localhost:8081"

# Node environment: development | test | production
NODE_ENV="development"

# Server-side Google Maps key (geocoding, distance matrix). Keep off the client.
GOOGLE_MAPS_API_KEY="replace-me"
