# ---------------------------------------------------------------------------
# SAMONA — example environment file
#
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
#   cp .env.example .env
#
# Mobile apps read only EXPO_PUBLIC_* variables; anything in an Expo app's
# bundle is public, so never put a secret behind an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Backend (server/) -----------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://samona:samona@localhost:5432/samona?schema=public"

# Redis connection string (caching, presence, queues).
REDIS_URL="redis://localhost:6379"

# Secret used to sign access tokens. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-value"

# Port the NestJS server listens on.
PORT=4000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS="http://localhost:8081"

# Node environment: development | test | production
NODE_ENV="development"

# --- Mobile (apps/pro/) ----------------------------------------------------

# Base URL of the SAMONA API. Never hardcode this in application code.
# Use your machine's LAN IP (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Google Maps key used for maps, geocoding and directions in the Pro app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="replace-me"

# --- Shared / tooling ------------------------------------------------------

# Server-side Google Maps key (geocoding, distance matrix). Keep off the client.
GOOGLE_MAPS_API_KEY="replace-me"

# Public URL of the API, used by tooling and future web surfaces.
API_URL="http://localhost:4000"
