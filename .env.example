# ---------------------------------------------------------------------------
# SAMONA — example environment file
#
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
#   cp .env.example .env
#
# Mobile apps read only EXPO_PUBLIC_* variables from apps/pro/.env; anything in
# an Expo bundle is public, so never put a secret behind an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
#
# Supabase provides both the managed PostgreSQL database and authentication.
# Prisma remains the data access layer.
#
# Connection strings: Dashboard -> Project Settings -> Database.
#
# DATABASE_URL must be the POOLED (Supavisor, port 6543) connection used at
# runtime. `pgbouncer=true` tells Prisma not to use prepared statements, which
# a transaction pooler cannot support.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL must be the DIRECT (port 5432) connection. `prisma migrate` needs a
# real session and cannot run through the transaction pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Project URL, e.g. https://abcdefgh.supabase.co (Dashboard -> API Keys).
# The server uses it to derive the JWKS that verifies access tokens.
SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Optional. Derived from SUPABASE_URL when empty; set only if the project
# publishes its keys somewhere non-standard.
SUPABASE_JWKS_URL=""

# Legacy HS256 signing secret. Leave empty on projects that sign with
# asymmetric keys (ES256) and publish a JWKS — check
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json: if it lists keys, leave this
# empty. Only older projects need it.
SUPABASE_JWT_SECRET=""

# Secret API key (sb_secret_...). Bypasses row-level security — never ship it
# to a client and never commit it. Only needed for administrative reads of
# auth.users; ordinary requests are authorised by the caller's own token.
SUPABASE_SECRET_KEY=""

# Role assigned to a user provisioned on first sign-in. This API currently
# serves the Pro app only; revisit when the customer app lands.
SIGNUP_DEFAULT_ROLE="PRO"

# --- Backend ---------------------------------------------------------------

# Redis connection string (rate limiting, presence, queues).
REDIS_URL="redis://localhost:6379"

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS="http://localhost:8081"

# Node environment: development | test | production
NODE_ENV="development"

# Server-side Google Maps key (geocoding, distance matrix). Keep off the client.
GOOGLE_MAPS_API_KEY="replace-me"

# --- Push notifications ----------------------------------------------------
#
# Expo push service. Leave EXPO_ACCESS_TOKEN empty in local dev to record
# notification rows without reaching Expo's servers. Get a token at
# https://expo.dev/settings/access-tokens for real deliveries.
EXPO_ACCESS_TOKEN=""

# Repeating job-alert cadence (ms) and a hard ceiling on how many times one
# alert re-pages a pro who has not acted. Sensible defaults apply when unset.
JOB_ALERT_REPEAT_MS="60000"
JOB_ALERT_MAX_REPEATS="0"
