{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    /* DOM gives us fetch/Response/AbortController, available in both React
       Native (Hermes) and Node 18+. */
    "lib": ["ES2023", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "references": [{ "path": "../types" }, { "path": "../config" }],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
