{
  "name": "@samona/app-updates",
  "version": "0.1.0",
  "private": true,
  "description": "Google Play in-app updates for the SAMONA Android apps (native Expo module + shared UI).",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
