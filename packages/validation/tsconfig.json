{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  // Project references make build order explicit: `tsc -b` builds @samona/types
  // first. npm does not order workspace `prepare` scripts by dependency.
  "references": [{ "path": "../types" }],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
