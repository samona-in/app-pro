// SAMONA database schema.
//
// Foundational only: the shared `User` record and its role. The full
// marketplace schema (ProProfile, Job, JobStatusHistory, Payment, Earning,
// Review, ...) lands with the features that need it — see CLAUDE.md
// "Database" for the expected entity set.
//
// Schema changes go through migrations. Never edit a deployed database by hand.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7 takes the connection URL from `prisma.config.ts` (for migrations)
// and from the driver adapter passed to PrismaClient (at runtime), so no `url`
// belongs here. The database is AWS RDS Postgres; Supabase is the identity
// provider only. `DIRECT_URL` is an optional Prisma convention that is unused
// today, since nothing sits between this API and the database.
datasource db {
  provider = "postgresql"
}

/// One account per person, whichever app they use — the identity layer.
///
/// Customer and Pro share this single table, and a person is both by default:
/// which surface they operate on is chosen per-request by the `X-App-Type`
/// header (the Pro app or the Customer app), and each has its own profile row
/// (CLAUDE.md "Authentication"). There is no single stored "role"; the surface
/// profile (`ProProfile` / `CustomerProfile`) is what carries surface data.
/// `isAdmin` is the only stored privilege, and it is never read from a token.
///
/// Supabase Auth owns credentials and phone verification. It is a separate
/// service: its `auth` schema is not in this database and this API never queries
/// it. This row owns domain data. There is no password column by design — the
/// application never sees or stores a credential.
model Profile {
  /// Equals the Supabase Auth user's id. Sharing the primary key keeps the link
  /// implicit, so anything holding a Supabase identity and anything holding a
  /// SAMONA profile agree without a join table.
  ///
  /// No Prisma relation is declared because there is nothing to declare one to:
  /// `auth.users` lives in Supabase, not in this database, and must not be
  /// managed by our migrations.
  id String @id @db.Uuid

  /// The only stored privilege. Authoritative; never read from a token claim or
  /// a client payload. A non-admin may operate on both the Pro and Customer
  /// surfaces; this flag grants additional, admin-only routes.
  isAdmin Boolean @default(false) @map("is_admin")

  /// Mirrored from the verified token on sign-in. Supabase verifies the phone
  /// number; we cache it for queries and display.
  email String? @unique
  phone String? @unique

  fullName  String?

  isActive Boolean @default(true)

  /// When the account was deleted. Set on the tombstone row (the row itself is
  /// never removed — Job.proId and Message.senderId reference it, and RESTRICT
  /// guards both). A deleted profile has no usable contact details and is
  /// rejected by `requireAuth`; dual-role accounts keep this null so the customer
  /// surface keeps working.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proProfile      ProProfile?
  customerProfile CustomerProfile?
  /// Chat messages this account sent in a job conversation.
  messages        Message[]
  /// The account-deletion workflow for this profile, when one exists.
  accountDeletion AccountDeletion?

  @@index([isActive])
  @@map("profiles")
}

/// What kind of professional this person is.
///
/// Split from `Profile` on purpose: identity ("who is this person in SAMONA")
/// and professional profile ("what do they do") change independently, and a
/// customer will never have one of these.
model ProProfile {
  id     String @id @default(uuid()) @db.Uuid
  /// One Pro profile per account. Unique, not just indexed.
  userId String @unique @map("user_id") @db.Uuid

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived from the required fields on write; see `isProProfileComplete`.
  /// Stored so routing does not have to recompute it on every request.
  onboardingStatus OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")

  displayName     String?          @map("display_name")
  gender          Gender?
  bio             String?
  experienceLevel ExperienceLevel? @map("experience_level")

  /// Kilometres. Bounded by LOCATION_DEFAULTS in @samona/config.
  serviceRadiusKm Int     @default(10) @map("service_radius_km")
  latitude        Float?
  longitude       Float?
  /// Human-readable label for the service area, shown back to the Pro.
  locationLabel   String? @map("location_label")

  languages String[] @default([])

  /// Storage path of the live-captured face photo inside the selfie bucket.
  /// The public URL is derived from it on read; a client never writes this.
  selfiePhotoPath  String?   @map("selfie_photo_path")
  /// When the accepted selfie finished uploading. Drives re-verification UX.
  selfieCapturedAt DateTime? @map("selfie_captured_at")

  /// Server-controlled. A client must never write these.
  isOnline      Boolean @default(false) @map("is_online")
  isVerified    Boolean @default(false) @map("is_verified")
  rating        Float?
  completedJobs Int     @default(0) @map("completed_jobs")

  /// Push delivery: the Expo device token registered by this Pro's own app.
  /// Written through the notifications domain, never trusted as a client-issued
  /// identity. Null until the app has asked for, and been granted, permission.
  pushToken String? @unique @map("push_token")

  /// The device OS that holds `pushToken`. The job-alert push is sent as a
  /// data-only message on Android (so the native full-screen service runs even
  /// when the app is closed) and as a display alert on iOS. Always written
  /// together with `pushToken`; null only for legacy registrations.
  pushPlatform PushPlatform? @map("push_platform")

  /// The push service that owns `pushToken`: `EXPO` via the Expo service,
  /// `FCM` via Firebase direct delivery. Null only for legacy registrations.
  pushProvider PushProvider? @map("push_provider")

  /// Whether this Pro wants job alerts at all. Server-side, so the API stays
  /// the single writer of preference; the app only toggles it through the
  /// notifications domain.
  jobAlertsEnabled Boolean @default(true) @map("job_alerts_enabled")

  /// A per-install identifier minted by the Android job-alert module and sent
  /// with the push token at registration. It binds minted job-offer tokens to
  /// one physical device, so an offer a push was delivered to cannot be
  /// redeemed from any other device. Null for legacy registrations.
  pushDeviceId String? @map("push_device_id")

  /// When the professional asked to delete their account. Set the moment a
  /// deletion is accepted so new matching, offers and job claims stop
  /// immediately; the pro keeps working only their already-active jobs until the
  /// sweeper finalizes. Never reverted once set.
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  /// When the tombstone was finalized. Set together with `Profile.deletedAt`
  /// (FULL scope) or alone (PRO_PROFILE scope). The row survives so historical
  /// jobs, ratings and cancellations keep their relationship; only PII is gone.
  deletedAt DateTime? @map("deleted_at")

  services      ProService[]
  skills        ProSkill[]
  documents     ProDocument[]
  /// Jobs this professional accepted. Authorised against ProProfile.userId.
  jobs          Job[]
  notifications Notification[]
  declines      JobDecline[]
  jobOffers     JobOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([onboardingStatus])
  @@index([isOnline])
  @@map("pro_profiles")
}

/// A customer's profile, storing their display identity and default location.
///
/// Much simpler than ProProfile: customers do not offer services, have no
/// skill matrix, and do not need verification. The profile exists so the
/// marketplace knows who is requesting work and where they are.
model CustomerProfile {
  id     String @id @default(uuid()) @db.Uuid
  /// One customer profile per account. Unique, not just indexed.
  userId String @unique @map("user_id") @db.Uuid

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived from required fields on write; see `isCustomerProfileComplete`.
  onboardingStatus OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")

  displayName   String? @map("display_name")
  gender        Gender?
  /// The customer's public profile photo. Lives on the surface profile (not
  /// the shared identity row) so a person who is both a customer and a
  /// professional keeps an independent image for each surface.
  avatarUrl     String? @map("avatar_url")
  locationLabel String? @map("location_label")
  latitude      Float?
  longitude     Float?

  /// Push delivery: the device push token registered by this customer's own app,
  /// written through the notifications domain. Mirrors the Pro profile fields so
  /// the same provider-aware delivery path can reach a customer.
  pushToken    String?       @unique @map("push_token")
  pushPlatform PushPlatform? @map("push_platform")
  pushProvider PushProvider? @map("push_provider")

  jobs          Job[]
  notifications CustomerNotification[]
  savedAddresses SavedAddress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([onboardingStatus])
  @@map("customer_profiles")
}

/// A customer's saved address — Home, Work or Other — reused at booking.
///
/// Distinct from the customer profile's single active location: the profile
/// holds *where the customer is right now* (matching fallback), while these
/// rows are the customer's permanent, labelled places. One customer may keep
/// several; at most one is the default.
model SavedAddress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  customer CustomerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// The customer's own name for this address (free text), shown in lists.
  name String

  /// Home, Work or Other — the human label shown across the app.
  label AddressLabel

  addressLine1 String @map("address_line1")
  addressLine2 String? @map("address_line2")
  landmark     String?
  locality     String?
  city         String?
  state        String?
  postalCode   String? @map("postal_code")

  latitude  Float
  longitude Float

  /// At most one default per customer; enforced by the service, not the schema.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("saved_addresses")
}

/// The service catalogue a professional selects from (onboarding step 3).
model Service {
  id        String  @id @default(uuid()) @db.Uuid
  /// Stable machine name, safe to reference from code and seeds.
  slug      String  @unique
  name      String
  icon      String?
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  skills Skill[]
  pros   ProService[]
  jobs   Job[]

  @@map("services")
}

/// A specialty within a service (onboarding step 4), e.g. "AC installation".
model Skill {
  id        String  @id @default(uuid()) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  slug      String
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pros    ProSkill[]
  jobs    Job[]

  @@unique([serviceId, slug])
  @@index([serviceId])
  @@map("skills")
}

/// A service a pro selected, plus its verification outcome.
///
/// Every service starts in `PENDING`. An admin reviews it offline and flips the
/// status directly in the database (there is no admin panel yet); the pro app
/// only reads this. `REJECTED` carries the reason the pro is shown.
model ProService {
  proProfileId String @map("pro_profile_id") @db.Uuid
  serviceId    String @map("service_id") @db.Uuid

  status          ProServiceStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason")

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([proProfileId, serviceId])
  @@index([status])
  @@map("pro_services")
}

model ProSkill {
  proProfileId String @map("pro_profile_id") @db.Uuid
  skillId      String @map("skill_id") @db.Uuid

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([proProfileId, skillId])
  @@map("pro_skills")
}

/// A document a pro submitted for review — identity, address, payout proof,
/// trade licence or a skill certificate.
///
/// Created `PENDING` by the upload handshake and moved only by an admin
/// review; the pro app reads the status and the rejection reason but never
/// writes either. Several documents of the same type may coexist (one
/// certificate per skill), so `type` is not unique.
///
/// Documents carry identity and bank details, so the bytes are never public:
/// `storagePath` points into a private bucket and reads go through a
/// short-lived presigned URL minted by the API for the owner or an admin.
/// Mirrors `DocumentType` / `DocumentStatus` in `@samona/types`.
model ProDocument {
  id           String         @id @default(uuid()) @db.Uuid
  proProfileId String         @map("pro_profile_id") @db.Uuid

  type   DocumentType
  status DocumentStatus @default(PENDING)

  /// Set when an admin rejects the document; shown verbatim to the Pro.
  rejectionReason String? @map("rejection_reason")
  /// When the verdict was returned. Null while `PENDING`.
  reviewedAt DateTime? @map("reviewed_at")

  /// The server-minted S3 key. A client never chooses where bytes land and
  /// never sees this value back — it is internal state, not a URL.
  storagePath String @unique @map("storage_path")

  /// The display name the Pro gave the file, bounded by the shared upload
  /// schema. Shown in the app; never used to build the storage key.
  fileName    String @map("file_name")
  /// Read from the object's own HEAD on complete, never trusted from the
  /// client: the declared content type is only a claim until the bytes land.
  contentType String @map("content_type")
  /// Likewise read from HEAD. Enforced against the per-kind limit there.
  sizeBytes   Int    @map("size_bytes")

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([proProfileId])
  @@map("pro_documents")
}

/// A service request placed by a customer.
///
/// Created in `REQUESTED` and moved exclusively by the backend through the
/// transitions in `@samona/types` `JOB_STATUS_TRANSITIONS`. The customer never
/// asserts a status; it only requests a transition.
model Job {
  id         String  @id @default(uuid()) @db.Uuid
  /// The CustomerProfile that placed the request.
  customerId String  @map("customer_id") @db.Uuid
  /// The ProProfile that accepted it; null until then.
  proId      String? @map("pro_id") @db.Uuid

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// RESTRICT, not SetNull: deleting a pro must never nullify a customer's
  /// historical job. Pro profiles are tombstones, never hard-deleted, so this
  /// can never actually fire — it is a guard against a future bug.
  pro      ProProfile?     @relation(fields: [proId], references: [id], onDelete: Restrict)

  serviceId String @map("service_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  /// The free-text category when `skill.slug` is `other` (a service-level
  /// sentinel skill). Null for any predefined category saved "as is".
  customSkill String? @map("custom_skill")

  status JobStatus @default(REQUESTED)

  /// Where the work will happen. `placeDescription` is captured when
  /// `placeType` is OTHER.
  placeType        PlaceType @map("place_type")
  placeDescription String?   @map("place_description")

  /// The work location, snapshotted onto the job when it is created so the job
  /// stays correct even when the customer's saved profile location changes or
  /// when they book from somewhere else entirely (e.g. an office after booking
  /// from home). The customer may submit a per-job location; when they do not,
  /// the customer profile's saved location is copied here at creation time.
  /// `locationLabel` is display-only; `latitude`/`longitude` drive distance,
  /// ETA and nearby-pro matching. Coordinates are null until one is known.
  locationLabel String? @map("location_label")
  latitude      Float?
  longitude     Float?

  /// Free-text description of the requested job.
  description String

  /// Storage paths of reference photos (0–5), inside the job-images bucket.
  /// Public URLs are derived on read; a client never writes these.
  imagePaths String[] @default([]) @map("image_paths")

  /// The guaranteed amount, in paise, the customer commits to paying. It is
  /// what makes acceptance attractive; the professional may still agree a
  /// different final charge once they understand the scope.
  basePayPaise   Int  @map("base_pay_paise")
  /// Amount agreed after the professional prices the actual scope.
  agreedPayPaise Int? @map("agreed_pay_paise")
  /// Amount actually settled, after the final charge is agreed.
  finalPayPaise  Int? @map("final_pay_paise")

  acceptedAt  DateTime? @map("accepted_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiresAt   DateTime? @map("expires_at")

  /// The one-time code the customer shares with the pro to start work.
  /// Generated once when the pro swipes Start Work; null until then. Never
  /// shipped to the pro's API view — only the customer, who reads it to the
  /// pro (CLAUDE.md "Security": never trust a client-supplied code, and only
  /// the party that can see it may enter it).
  verificationOtp String? @map("verification_otp")
  /// When `verificationOtp` was issued, so a repeat Start Work swipe cannot
  /// mint a fresh code — one job, one code, one chance to start.
  otpIssuedAt DateTime? @map("otp_issued_at")
  /// Failed attempts to verify the start code, so a wrong code cannot be
  /// sprayed indefinitely even across many callers (pairs with the per-identity
  /// brute-force guard in `common/security/brute-force.ts`).
  startOtpAttempts Int @default(0) @map("start_otp_attempts")

  statusHistory JobStatusHistory[]
  notifications Notification[]
  customerNotifications CustomerNotification[]
  declines      JobDecline[]
  jobOffers     JobOffer[]
  messages      Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, status])
  @@index([serviceId, status])
  @@index([proId, status])
  @@index([createdAt])
  @@map("jobs")
}

/// One recorded transition in a job's life, for audit and the client timeline.
///
/// `fromStatus` is null for the row that records the job's creation.
model JobStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  jobId       String     @map("job_id") @db.Uuid
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Null means the job was created into `toStatus`.
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  /// The profile/user that drove the transition; null for a system action.
  changedById String?    @map("changed_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([jobId])
  @@map("job_status_history")
}

/// A push notification the API delivered to a professional.
///
/// REST remains the source of truth for the job; this row records the *push*
/// itself so the Notifications screen can list history and so a repeating job
/// alert knows who has already been paged. Repeats do not create new rows —
/// the `repeats` counter scans what was already sent for that event.
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  /// The ProProfile this push was delivered to.
  proId       String           @map("pro_id") @db.Uuid
  pro         ProProfile       @relation(fields: [proId], references: [id], onDelete: Cascade)
  /// The job the alert was about, when it was a job alert.
  jobId       String?          @map("job_id") @db.Uuid
  job         Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Short machine label, e.g. `job_alert`. Mirrors `NotificationKind`.
  kind        NotificationKind @map("kind")
  /// The title shown in the push.
  title       String
  /// The body shown in the push.
  body        String
  /// i18n key (in the pro app's resources) that composes `title`; null means
  /// `title` is authoritative. See `messageBodyKey` / `params`.
  messageKey  String?          @map("message_key")
  /// i18n key that composes `body`; null means `body` is authoritative.
  messageBodyKey String?       @map("message_body_key")
  /// Interpolation values for `messageKey` / `messageBodyKey` (JSON object of
  /// string values; catalogue data passes through unlocalized).
  params      Json?            @db.JsonB
  /// The deep-link / route to open when the alert is tapped.
  route       String?
  /// Whether the latest attempt to deliver this alert succeeded.
  delivered   Boolean          @default(false)
  /// Errors from the push provider, logged server-side; never sent to clients.
  providerRef String?          @map("provider_ref")
  /// How many times this same alert has been re-sent (repeat mode).
  repeats     Int              @default(0)
  /// Set once the alert stops recurring (job accepted, expired, cancelled).
  resolvedAt  DateTime?        @map("resolved_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([proId, jobId, kind])
  @@index([proId, createdAt])
  @@index([jobId])
  @@map("notifications")
}

/// A status/payment notification shown in the Customer app's Notifications
/// screen (opened from the bell on the home screen).
///
/// Where the pro `Notification` row records a *push* (delivery state, repeats,
/// resolution), this row records a *notice*: a job-status or payment event the
/// API chooses to surface to a customer. It is written by the jobs domain at
/// each transition it publishes and read back here; `readAt` tracks whether the
/// customer has acknowledged it. Rows carry a `kind` from the shared enum but
/// no push machinery, because customer notices are in-app only — a push to the
/// customer for a job event is a separate, later concern.
model CustomerNotification {
  id         String           @id @default(uuid()) @db.Uuid
  /// The CustomerProfile this notice belongs to.
  customerId String           @map("customer_id") @db.Uuid
  customer   CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The booking a job-status notice is about; null for a system notice.
  jobId      String?          @map("job_id") @db.Uuid
  job        Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Short machine label, e.g. `job_status`. Mirrors `NotificationKind`.
  kind       NotificationKind @map("kind")
  /// The title shown on the row, e.g. "Rakesh took your booking".
  title      String
  /// The body shown under the title.
  body       String
  /// The in-app route to open on tap, e.g. `/booking/{jobId}`. Null when there
  /// is nowhere useful to send the customer (e.g. a system notice).
  route      String?
  /// The customer opened it; null while unread. The bell's unread pill counts
  /// rows where this is null.
  readAt     DateTime?         @map("read_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([jobId])
  @@map("customer_notifications")
}

/// One professional who explicitly declined an open job request.
///
/// A decline is per pro per job: it stops that pro from being paged for the
/// request again (the repeating push scheduler, the `/jobs/available` feed and
/// the alert refetch by id) for as long as the job stays open. It records
/// nothing about the job's own status — the customer is never told a decline
/// happened, and the request simply leaves this pro's pool. Idempotent: only
/// the first row matters, so a duplicate Reject tap or a racing network retry
/// is harmless.
model JobDecline {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @map("job_id") @db.Uuid
  proId String @map("pro_id") @db.Uuid

  job Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pro ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([jobId, proId])
  @@index([proId])
  @@map("job_declines")
}

/// A single-use offer token minted for one pro on one open job and delivered
/// inside the job alert's FCM data.
///
/// The token itself is a signed compact blob (HMAC'd with `JOB_OFFER_SECRET`)
/// carrying the pro, job, device and expiry; this row is the single-use ledger.
/// Accept and Reject atomically flip `tokenHash` from unused to consumed, so a
/// replayed token can never act twice, and `outcome` records where it landed.
/// One row per *delivery* — the repeating alert mints a fresh token each time it
/// pages a pro who has not acted, so each push stays independently actionable.
model JobOffer {
  id         String           @id @default(uuid()) @db.Uuid
  jobId      String           @map("job_id") @db.Uuid
  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proId      String           @map("pro_id") @db.Uuid
  pro        ProProfile       @relation(fields: [proId], references: [id], onDelete: Cascade)
  /// SHA-256 of the signed token; the token text is never stored.
  tokenHash  String           @unique @map("token_hash")
  /// The device the token is bound to (ProProfile.pushDeviceId at mint time).
  deviceId   String?          @map("device_id")
  /// When the signed token stops being redeemable.
  expiresAt  DateTime         @map("expires_at")
  /// Set once the token has been acted on; null while still redeemable.
  consumedAt DateTime?        @map("consumed_at")
  outcome    JobOfferOutcome? @map("outcome")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([jobId])
  @@index([proId])
  @@index([expiresAt])
  @@map("job_offers")
}

/// A chat message inside a job conversation.
///
/// Messaging exists only between the two parties of an accepted job — a message
/// is anchored to the `Job` and the `Profile` that sent it, so no "conversation"
/// table is needed. REST stays the source of truth; Socket.IO delivers the
/// `message:new` nudge and the read/delivered receipts are persisted here so a
/// client can draw the WhatsApp-style clock → single tick → double tick →
/// double-blue sequence.
model Message {
  id          String     @id @default(uuid()) @db.Uuid
  /// The job the conversation belongs to.
  jobId       String     @map("job_id") @db.Uuid
  /// Which Profile sent this message (matches `auth.users.id`, like `Profile`).
  senderId    String     @map("sender_id") @db.Uuid
  /// Which side of the job sent it. Stored, never derived: one account can be
  /// both the customer and the pro of the same job, so `senderId` alone cannot
  /// tell the sides apart. Mirrors `UserRole` in `@samona/types`.
  senderRole  SenderRole @map("sender_role")
  /// The message text. Bounded by the shared send schema (max 500 chars).
  content     String
  /// When the server persisted the message.
  sentAt      DateTime   @default(now()) @map("sent_at")
  /// When the recipient's device confirmed delivery (double grey tick).
  deliveredAt DateTime? @map("delivered_at")
  /// When the recipient's app marked the message as read (double blue tick).
  readAt      DateTime? @map("read_at")

  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// RESTRICT, not Cascade: deleting a profile must never wipe chat history the
  /// other party still needs. Profiles are tombstones, never hard-deleted, so
  /// this can never actually fire — it is a guard against a future bug.
  sender Profile @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([jobId, sentAt])
  @@map("messages")
}

/// A durable, resumable record of a professional's account-deletion request.
///
/// One row per profile. It holds both sides of the feature:
///
/// - the **single-use deletion authorization** minted only after the backend has
///   verified a fresh OTP (`authTokenHash` / `authTokenExpiresAt` /
///   `authTokenConsumedAt`), and
/// - the **workflow state** as deletion runs in idempotent, retry-safe steps
///   across Prisma, S3 and Supabase Auth (`status`, `step`, `attempts`).
///
/// A row is created when the authorization is issued; the raw token is returned
/// to the client exactly once and every other step works on the hash, which
/// mirrors the `JobOffer.tokenHash` single-use pattern. Each step records its
/// completion before moving on, so a crash mid-flight resumes from the last
/// finished step instead of redoing or skipping work.
model AccountDeletion {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @unique @map("profile_id") @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  /// Whether the account carries a CustomerProfile. Determines what deletion
  /// removes: `PRO_PROFILE` keeps the customer surface and Supabase Auth,
  /// `FULL_ACCOUNT` tears the identity down completely.
  scope AccountDeletionScope

  status AccountDeletionStatus @default(AUTHORIZED)
  /// The last workflow step that finished. `null` while nothing has run yet.
  step   AccountDeletionStep?
  attempts Int @default(0)
  lastError String?

  /// The legal-hold decision, captured exactly once before the first
  /// destructive step and consumed by both PURGE_S3 and PURGE_DB. Freezing it
  /// on the row means a hold created between the two steps can no longer make
  /// one step preserve what the other deleted. `null` until captured.
  holdsCapturedAt DateTime? @map("holds_captured_at")
  /// Whether a profile-level hold protects every object the account owns.
  profileHeld Boolean @default(false) @map("profile_held")
  /// Storage paths of a profile's documents an active hold protects.
  heldDocumentPaths String[] @default([]) @map("held_document_paths")

  /// SHA-256 of the single-use deletion authorization. The raw token is shown
  /// to the client once at issue; this hash is all that is ever stored.
  authTokenHash     String?   @unique @map("auth_token_hash")
  authTokenExpiresAt DateTime? @map("auth_token_expires_at")
  authTokenConsumedAt DateTime? @map("auth_token_consumed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("account_deletions")
}

/// How much of the account a deletion removes.
///
/// Decided server-side from the account shape (presence of a CustomerProfile),
/// never from the client.
enum AccountDeletionScope {
  PRO_PROFILE
  FULL_ACCOUNT
}

/// The lifecycle of an account-deletion workflow.
///
/// `AUTHORIZED` — a fresh OTP was verified and a single-use token issued; the
/// `DELETE` call has not consumed it yet. `AWAITING_ACTIVE_JOBS` — deletion was
/// accepted but the pro still has active jobs, so finalization is deferred (new
/// bookings are already blocked). `IN_PROGRESS` — the sweeper is running steps.
/// `COMPLETED` / `FAILED` are terminal.
enum AccountDeletionStatus {
  AUTHORIZED
  AWAITING_ACTIVE_JOBS
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// The idempotent steps of the workflow, run in order. Each step is recorded
/// only after it finishes, so a crash resumes from the last finished step.
enum AccountDeletionStep {
  LOCK
  PURGE_S3
  PURGE_DB
  DELETE_AUTH
  FINALIZE
}

/// How a minted job-offer token was settled. Mirrors the terminal push kinds.
enum JobOfferOutcome {
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Mirrored by `PlaceType` in `@samona/types` — keep the two in sync.
enum PlaceType {
  RESIDENCE
  OFFICE
  OTHER
}

/// Mirrored by `JobStatus` in `@samona/types` — keep the two in sync.
enum JobStatus {
  REQUESTED
  OFFERED
  ACCEPTED
  TRAVELLING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAYMENT_PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// How a pro's selected service is verified. Mirrored by `ProServiceStatus` in
/// `@samona/types` — keep the two in sync.
enum ProServiceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// What a submitted document proves. Mirrored by `DocumentType` in
/// `@samona/types` — keep the two in sync.
enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  PAYOUT_PROOF
  TRADE_LICENCE
  CERTIFICATE
  OTHER
}

/// A document's review outcome. Mirrored by `DocumentStatus` in
/// `@samona/types` — keep the two in sync. `APPROVED` rather than the
/// `ACCEPTED` ProServiceStatus uses: an "accepted document" reads wrong.
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExperienceLevel {
  UNDER_1_YEAR
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_TO_TEN
  TEN_PLUS
}

/// Mirrored by `Gender` in `@samona/types` — keep the two in sync.
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Where a saved address points to. Mirrored by `AddressLabel` in `@samona/types`
/// — keep the two in sync.
enum AddressLabel {
  HOME
  WORK
  OTHER
}

/// The OS a push token was registered from. Used only to shape the push
/// payload: Android job alerts are data-only so the native full-screen service
/// runs even when the app is closed; iOS gets a display alert.
enum PushPlatform {
  IOS
  ANDROID
}

/// The push service a registered token belongs to. `EXPO` goes through the
/// Expo push service; `FCM` goes through Firebase Cloud Messaging HTTP v1
/// directly (native Android job alerts). Always written together with
/// `pushToken`; null only for legacy registrations.
enum PushProvider {
  EXPO
  FCM
}

/// Which side of a job authored a chat `Message`. Mirrors `UserRole` in
/// `@samona/types` — keep the two in sync.
enum SenderRole {
  CUSTOMER
  PRO
}

/// The kind of push a professional may receive. Mirrors `NotificationKind` in
/// `@samona/types` — keep the two in sync.

/// Legal hold holder types
enum LegalHoldHolderType {
  PROFILE
  PRO_PROFILE
  DOCUMENT
  JOB
  CUSTOMER_PROFILE
  OTHER
}

enum NotificationKind {
  JOB_ALERT
  JOB_STATUS
  PAYMENT
  SYSTEM
}


/// Retention cleanup audit log - records automated cleanup operations.
/// No PII is stored; errors are sanitized.
model CleanupAuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  category      String
  action        String
  affectedCount Int       @default(0) @map("affected_count")
  executionMode String    @map("execution_mode") // DRY_RUN or ACTUAL
  startedAt     DateTime  @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  success       Boolean
  error         String?
  metadata      Json?     @db.JsonB
  jobId         String?   @map("job_id")

  @@index([category, startedAt])
  @@map("cleanup_audit_logs")
}

/// Legal hold to prevent deletion of records
model LegalHold {
  id            String              @id @default(uuid()) @db.Uuid
  holderType    LegalHoldHolderType @map("holder_type")
  holderId      String              @map("holder_id")
  reason        String
  authorizedBy  String              @map("authorized_by")
  notes         String?
  active        Boolean             @default(true)
  releasedAt    DateTime?           @map("released_at")
  releasedBy    String?             @map("released_by")
  expiresAt     DateTime?           @map("expires_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([holderType, holderId, active])
  @@index([active, expiresAt])
  @@map("legal_holds")
}
