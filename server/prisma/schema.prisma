// SAMONA database schema.
//
// Foundational only: the shared `User` record and its role. The full
// marketplace schema (ProProfile, Job, JobStatusHistory, Payment, Earning,
// Review, ...) lands with the features that need it — see CLAUDE.md
// "Database" for the expected entity set.
//
// Schema changes go through migrations. Never edit a deployed database by hand.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7 takes the connection URL from `prisma.config.ts` (for migrations)
// and from the driver adapter passed to PrismaClient (at runtime), so no `url`
// belongs here. Supabase is the managed host; see .env.example for why the
// pooled and direct URLs differ.
datasource db {
  provider = "postgresql"
}

/// One account per person, whichever app they use — the identity layer.
///
/// Customer, Pro and Admin share this table so a single authentication system
/// serves all three (CLAUDE.md "Authentication"). Role-specific data belongs in
/// a profile table joined to this one.
///
/// Supabase Auth owns credentials and phone verification in the `auth.users`
/// table of this same database. This row owns domain data and is the authority
/// on `role`. There is no password column by design — the application never
/// sees or stores a credential.
model Profile {
  /// Matches `auth.users.id`. Sharing the primary key keeps the join implicit
  /// and makes any future RLS policy a plain `auth.uid() = id` comparison.
  ///
  /// No Prisma relation is declared: `auth.users` belongs to Supabase and must
  /// not be managed by our migrations. The foreign key is added by hand in the
  /// migration instead.
  id        String   @id @db.Uuid

  /// Authoritative. Never read from a token claim or a client payload.
  role      UserRole @default(CUSTOMER)

  /// Mirrored from the verified token on sign-in. Supabase verifies the phone
  /// number; we cache it for queries and display.
  email     String?  @unique
  phone     String?  @unique

  fullName  String?
  avatarUrl String?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proProfile ProProfile?
  customerProfile CustomerProfile?

  @@index([role])
  @@map("profiles")
}

/// What kind of professional this person is.
///
/// Split from `Profile` on purpose: identity ("who is this person in SAMONA")
/// and professional profile ("what do they do") change independently, and a
/// customer will never have one of these.
model ProProfile {
  id     String @id @default(uuid()) @db.Uuid
  /// One Pro profile per account. Unique, not just indexed.
  userId String @unique @map("user_id") @db.Uuid

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived from the required fields on write; see `isProProfileComplete`.
  /// Stored so routing does not have to recompute it on every request.
  onboardingStatus OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")

  displayName     String? @map("display_name")
  gender          Gender?
  bio             String?
  experienceLevel ExperienceLevel? @map("experience_level")

  /// Kilometres. Bounded by LOCATION_DEFAULTS in @samona/config.
  serviceRadiusKm Int    @default(10) @map("service_radius_km")
  latitude        Float?
  longitude       Float?
  /// Human-readable label for the service area, shown back to the Pro.
  locationLabel   String? @map("location_label")

  languages String[] @default([])

  /// Storage path of the live-captured face photo inside the selfie bucket.
  /// The public URL is derived from it on read; a client never writes this.
  selfiePhotoPath String?    @map("selfie_photo_path")
  /// When the accepted selfie finished uploading. Drives re-verification UX.
  selfieCapturedAt DateTime? @map("selfie_captured_at")

  /// Server-controlled. A client must never write these.
  isOnline      Boolean @default(false) @map("is_online")
  isVerified    Boolean @default(false) @map("is_verified")
  rating        Float?
  completedJobs Int     @default(0) @map("completed_jobs")

  services ProService[]
  skills   ProSkill[]

  /// The requests this pro chose to take on. The client never writes
  /// `ServiceRequest.selectedProId`; only the backend's atomic selection
  /// transaction sets it.
  selectedRequests ServiceRequest[] @relation("selectedRequests")

  /// Dispatched offers and open-job interests, one row per request.
  offers    JobOffer[]
  interests ProInterest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([onboardingStatus])
  @@index([isOnline])
  @@map("pro_profiles")
}

/// A customer's profile, storing their display identity and default location.
///
/// Much simpler than ProProfile: customers do not offer services, have no
/// skill matrix, and do not need verification. The profile exists so the
/// marketplace knows who is requesting work and where they are.
model CustomerProfile {
  id     String @id @default(uuid()) @db.Uuid
  /// One customer profile per account. Unique, not just indexed.
  userId String @unique @map("user_id") @db.Uuid

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived from required fields on write; see `isCustomerProfileComplete`.
  onboardingStatus OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")

  displayName   String? @map("display_name")
  gender        Gender?
  addressLabel  String? @map("address_label")
  locationLabel String? @map("location_label")
  latitude      Float?
  longitude     Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requests ServiceRequest[] @relation("customerRequests")

  @@index([onboardingStatus])
  @@map("customer_profiles")
}

/// The service catalogue a professional selects from (onboarding step 3).
model Service {
  id       String  @id @default(uuid()) @db.Uuid
  /// Stable machine name, safe to reference from code and seeds.
  slug     String  @unique
  name     String
  icon     String?
  sortOrder Int    @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")

  skills Skill[]
  pros   ProService[]
  requests ServiceRequest[]

  @@map("services")
}

/// A specialty within a service (onboarding step 4), e.g. "AC installation".
model Skill {
  id        String  @id @default(uuid()) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  slug      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pros    ProSkill[]

  @@index([serviceId])
  @@map("skills")
}

model ProService {
  proProfileId String @map("pro_profile_id") @db.Uuid
  serviceId    String @map("service_id") @db.Uuid

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([proProfileId, serviceId])
  @@map("pro_services")
}

model ProSkill {
  proProfileId String @map("pro_profile_id") @db.Uuid
  skillId      String @map("skill_id") @db.Uuid

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([proProfileId, skillId])
  @@map("pro_skills")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ExperienceLevel {
  UNDER_1_YEAR
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_TO_TEN
  TEN_PLUS
}

/// Mirrored by `Gender` in `@samona/types` — keep the two in sync.
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Mirrored by `UserRole` in `@samona/types` — keep the two in sync.
enum UserRole {
  CUSTOMER
  PRO
  ADMIN
}

// ---------------------------------------------------------------------------
// Order service lifecycle — SAMONA__Onboarding_&_Order_Service_Architecture.md
//
// A customer first files a ServiceRequest; there is no confirmed Job yet. The
// request carries the whole lifecycle while the customer has not chosen a pro.
// Dispatch is modelled as JobOffers (one per pro, instant dispatch) and open
// supply gaps as ProInterests (available jobs). When the customer selects a
// pro the request becomes the confirmed "job", and the same row moves through
// the on-site stages. REST is the source of truth; realtime only delivers it.
// ---------------------------------------------------------------------------

/// The lifecycle of `service_requests` (architecture §21).
///
/// Temporary states REQUESTED/DISPATCHING/OPEN/CHOOSING_PRO have an
/// `expires_at`; the expiry sweeper moves them to EXPIRED. After the customer
/// selects a pro the request is the confirmed job and the pro drives the
/// on-site stages.
enum ServiceRequestStatus {
  REQUESTED
  DISPATCHING
  CHOOSING_PRO
  OPEN
  CONFIRMED
  TRAVELLING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
  EXPIRED
}

/// A single pro's dispatch offer, separate from the request (architecture §22).
///
/// At most one offer per pro per request; distance and ETA are snapshots made
/// at offer time so history stays meaningful after the pro moves.
enum JobOfferStatus {
  OFFERED
  ACCEPTED
  /// The customer picked this pro. Exactly one of a request's offers reaches
  /// SELECTED; every other non-terminal one is CANCELLED in the same
  /// transaction.
  SELECTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// A pro's expression of interest in an open request (architecture §27).
enum ProInterestStatus {
  INTERESTED
  SELECTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

/// A customer's request for a service, before and after a pro is chosen.
model ServiceRequest {
  id String @id @default(uuid()) @db.Uuid

  customerId String @map("customer_id") @db.Uuid
  serviceId  String @map("service_id") @db.Uuid
  status     ServiceRequestStatus @default(REQUESTED)

  /// The problem, free text plus optional photo references (as produced by the
  /// files domain; never an arbitrary client URL).
  description String?
  photos      String[] @default([])
  /// Where the work must happen. Nullable so a customer far from a network
  /// still gets an open request listed for the pro to view.
  latitude  Float?
  longitude Float?
  address   String?

  /// Set only by the atomic selection transaction. A confirmed request is the
  /// pro's current job.
  selectedProId String? @map("selected_pro_id") @db.Uuid

  /// Rupees. `estimatedPrice` is a V1 budget/quote anchor from creation;
  /// `finalPrice` is set server-side at completion and never borrowed from a
  /// client payload.
  estimatedPrice Int? @map("estimated_price")
  finalPrice     Int? @map("final_price")

  requestedAt DateTime @default(now()) @map("requested_at")
  /// When a temporary state lapses into EXPIRED. Null while confirmed/in-flight.
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer CustomerProfile @relation("customerRequests", fields: [customerId], references: [userId], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id])
  selectedPro ProProfile?  @relation("selectedRequests", fields: [selectedProId], references: [id])

  offers   JobOffer[]
  interests ProInterest[]

  /// Every state change of this request, in order.
  statusHistory JobStatusHistory[]
  payment Payment?

  @@index([customerId, status])
  @@index([serviceId])
  @@index([status, expiresAt])
  @@index([selectedProId, status])
  @@map("service_requests")
}

/// Instant-dispatch offer to one pro (architecture §22, §26).
model JobOffer {
  id String @id @default(uuid()) @db.Uuid

  serviceRequestId String @map("service_request_id") @db.Uuid
  proId            String @map("pro_id") @db.Uuid
  status           JobOfferStatus @default(OFFERED)

  /// Snapshots taken when the offer was created.
  distanceKm           Float @map("distance_km")
  estimatedEtaMinutes  Int   @map("estimated_eta_minutes")

  offeredAt   DateTime  @default(now()) @map("offered_at")
  respondedAt DateTime? @map("responded_at")
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  pro ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, proId])
  @@index([proId, status, expiresAt])
  @@index([serviceRequestId, status])
  @@map("job_offers")
}

/// A pro's interest in an open request (architecture §27).
model ProInterest {
  id String @id @default(uuid()) @db.Uuid

  serviceRequestId String @map("service_request_id") @db.Uuid
  proId            String @map("pro_id") @db.Uuid
  status           ProInterestStatus @default(INTERESTED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  pro ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, proId])
  @@index([proId, status])
  @@index([serviceRequestId, status])
  @@map("pro_interests")
}

/// History of a request's status changes, so the timeline is reproducible
/// even after REST state has moved on.
model JobStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  serviceRequestId String @map("service_request_id") @db.Uuid
  status           ServiceRequestStatus
  /// The verified user id of whoever triggered the change.
  changedById String @map("changed_by_id") @db.Uuid
  /// Optional context, e.g. "offer expired while dispatching".
  note String?

  createdAt DateTime @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId, createdAt])
  @@map("job_status_history")
}

/// Money recorded for a confirmed request. The gateway is not wired for V1:
/// `markPaid` in the payments domain is the authoritative transition.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  serviceRequestId String @unique @map("service_request_id") @db.Uuid
  status PaymentStatus @default(PENDING)

  /// Rupees, set server-side from the request's authoritative price.
  amount Int

  paidAt   DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("payments")
}
