# SAMONA Customer — mobile environment.
#
# Copy to `apps/customer/.env` and adjust. Expo loads .env from the app
# directory, not the monorepo root.
#
# Everything here is inlined into the app bundle and is therefore PUBLIC.
# Never put a secret behind an EXPO_PUBLIC_ prefix.

# Base URL of the SAMONA API.
EXPO_PUBLIC_API_URL="https://24ab-49-37-148-205.ngrok-free.app"

# Supabase project URL and publishable key (Dashboard -> API Keys).
EXPO_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# EAS project id, used to mint Expo push tokens. Public. Copy from
# app.json -> expo.extra.eas.projectId. Required so locally-built APKs can
# register push tokens (Constants.easConfig is null outside EAS cloud builds).
EXPO_PUBLIC_EAS_PROJECT_ID="replace_me"

# Google Maps key for maps, geocoding and directions.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""

# TEST-ONLY phone sign-in bypass. Set BOTH to the Supabase "test phone number"
# you add in Dashboard -> Auth -> Phone -> Test phone numbers (format without
# the +: e.g. 919876543210=111222). When set, the verify screen offers to fill
# the fixed code and the phone screen offers this number, so no SMS is sent
# (useful when there are no Twilio credits). Leave BOTH empty in production.
#
# EXPO_PUBLIC_AUTH_TEST_PHONE="+919876543210"
# EXPO_PUBLIC_AUTH_TEST_OTP="111222"
