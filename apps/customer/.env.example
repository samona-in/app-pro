# SAMONA Customer — mobile environment.
#
# Copy to `apps/customer/.env` and adjust. Expo loads .env from the app
# directory, not the monorepo root.
#
# Everything here is inlined into the app bundle and is therefore PUBLIC.
# Never put a secret behind an EXPO_PUBLIC_ prefix.

# Base URL of the SAMONA API.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Supabase project URL and publishable key (Dashboard -> API Keys).
EXPO_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Google Maps key for maps, geocoding and directions.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
