{
  "expo": {
    "name": "SAMONA",
    "slug": "samona-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samona",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.samona.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SAMONA uses your location to show nearby professionals and services available in your area.",
        "NSPhotoLibraryUsageDescription": "SAMONA needs access to your photos so you can upload a profile picture.",
        "NSCameraUsageDescription": "SAMONA needs camera access so you can take a photo for your profile."
      }
    },
    "android": {
      "package": "in.samona.customer",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SAMONA uses your location to show nearby professionals and services available in your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SAMONA needs access to your photos so you can upload a profile picture.",
          "cameraPermission": "SAMONA needs camera access so you can take a photo for your profile."
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34c94c1f-e733-4ee1-8d93-be6467e286b0"
      }
    },
    "owner": "naveenalla"
  }
}
