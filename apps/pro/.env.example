# SAMONA Pro — mobile environment.
#
# Copy to `apps/pro/.env` and adjust. Expo loads .env from the app directory,
# not the monorepo root (the root .env.example documents the server's vars).
#
# Everything here is inlined into the app bundle and is therefore PUBLIC.
# Never put a secret behind an EXPO_PUBLIC_ prefix.

# Base URL of the SAMONA API.
# Use your machine's LAN IP instead of localhost when testing on a real device.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Google Maps key for maps, geocoding and directions.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
