{
  "expo": {
    "name": "SAMONA Pro",
    "slug": "samona-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samonapro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.samona.pro",
      "newArchEnabled": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SAMONA Pro uses your location to show you nearby job requests and to share your progress with the customer while you are on a job.",
        "NSPhotoLibraryUsageDescription": "SAMONA Pro needs access to your photos so you can upload your profile picture and job documents.",
        "NSCameraUsageDescription": "SAMONA Pro needs camera access so you can take photos for your profile and job documents."
      }
    },
    "android": {
      "package": "in.samona.pro",
      "versionCode": 5,
      "newArchEnabled": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#054DFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#054DFF",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SAMONA Pro uses your location to show you nearby job requests and to share your progress with the customer while you are on a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SAMONA Pro needs access to your photos so you can upload your profile picture and job documents.",
          "cameraPermission": "SAMONA Pro needs camera access so you can take photos for your profile and job documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Samona.png",
          "color": "#0F172A",
          "defaultChannel": "incoming_jobs",
          "enableBackgroundRemoteNotifications": true,
          "sounds": ["./assets/audio/job_alert.wav"]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bae33e5c-b4d7-489f-a065-40c610d87d20"
      }
    },
    "owner": "naveenalla"
  }
}
